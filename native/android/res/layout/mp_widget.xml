<?xml version="1.0" encoding="utf-8"?>
<!-- 마이플래너 홈 화면 위젯: 다음 일정 기상 · 출발 · 도착 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mp_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/mp_widget_bg">

    <TextView
        android:id="@+id/mp_w_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:text="마이플래너" />

    <TextView
        android:id="@+id/mp_w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="예정된 일정이 없어요" />

    <LinearLayout
        android:id="@+id/mp_w_times"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기상" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/mp_w_wake" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="22sp" android:textStyle="bold" android:text="--:--" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="출발" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/mp_w_depart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="22sp" android:textStyle="bold" android:text="--:--" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/mp_w_end_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="도착" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/mp_w_end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="22sp" android:textStyle="bold" android:text="--:--" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/mp_w_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
</LinearLayout>
